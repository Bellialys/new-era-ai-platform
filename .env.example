# OpenRouter API
# Reference env catalog only. The primary local template is .env.local.example.
# Copy .env.local.example to .env.local and fill real values only locally.
# CRITICAL: Never commit .env.local to git repository
# Single source of truth for variables: env-check.config.json.
# `npm run env:check:example` regenerates .env.local.example from that config;
# `npm run env:check` validates them. Keep this reference file in sync with
# env-check.config.json and .env.local.example.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Dedicated signing secret for the short-lived OpenRouter OAuth flow cookie.
# Generate at least 32 random characters. Never expose with NEXT_PUBLIC_.
OPENROUTER_OAUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Supabase (for v0.5+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback alias accepted by the client and env checker.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only key for Supabase persistence.
# Never use this in browser code and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Database / migrations (needed for `npm run schema:check` and Supabase CLI).
# Supabase -> Project Settings -> Database -> Connection string (URI).
# DATABASE_URL is accepted as an alias of SUPABASE_DB_URL. Never commit real values.
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=

# App settings
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags
# Set to "true" to enable the /team page. Defaults to disabled (coming soon state).
NEXT_PUBLIC_ENABLE_TEAM_MODE=false
# Stage 3.4 OAuth beta. Both flags must be true before Connect OpenRouter is available.
ENABLE_OPENROUTER_USER_OAUTH=false
# Keep false until the Stage 3.2 AWS/Vercel KMS live + environment-isolation gate is complete.
ENABLE_PROVIDER_CREDENTIAL_PERSISTENCE=false
# Platform-funded Image Arena can incur direct provider spend. Keep false unless
# an explicit monetary rollout has been approved and verified.
ENABLE_PLATFORM_PAID_IMAGE_ARENA=false

# OpenRouter request limits (read at runtime)
# Prompt length and model-count limits live in src/lib/arena/constants.ts
MODEL_TIMEOUT_MS=60000
OPENROUTER_MAX_TOKENS=1000

# AWS KMS provider-credential encryption (Stage 3.2 live gate).
# Validate with: npm run env:check -- --mode=kms
# Use Vercel OIDC only. Never add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN.
AWS_REGION=eu-west-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/new-era-vercel-kms
AI_CREDENTIAL_KMS_KEY_ID=arn:aws:kms:eu-west-1:123456789012:key/00000000-0000-0000-0000-000000000000

# Rate limiting (optional locally, REQUIRED before a public/serverless deploy).
# Without these the limiter is in-memory and does not work across instances.
# Create a free Redis at https://console.upstash.com and paste the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Deployment Protection automation bypass (optional; server/CI only).
# Used by `npm run smoke` against protected preview deployments.
VERCEL_AUTOMATION_BYPASS_SECRET=
